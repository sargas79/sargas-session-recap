{
  "name": "sargas-session-recap",
  "version": "0.0.0",
  "private": true,
  "description": "Session Recap Bot: PF2e session audio to transcript, classification, evidence-linked recap and GM-only Foundry journal.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "packages/contracts",
    "packages/core"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "recap": "node packages/core/bin/recap.js",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
