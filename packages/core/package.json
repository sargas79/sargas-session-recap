{
  "name": "@sargas-recap/core",
  "version": "0.0.0",
  "private": true,
  "description": "Session Recap Bot core: CLI and pipeline stages (capture, package, jobs, transcribe, classify, recap, review).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "bin": {
    "recap": "./bin/recap.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "prompts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.js",
    "typecheck": "tsc -p tsconfig.json",
    "recap": "node src/cli/main.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "@napi-rs/keyring": "2.1.2",
    "@sargas-recap/contracts": "0.0.0",
    "better-sqlite3": "12.11.1",
    "commander": "^15.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0"
  }
}
