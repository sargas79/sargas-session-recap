{
  "name": "@sargas-recap/core",
  "version": "0.0.0",
  "private": true,
  "description": "Session Recap Bot core: CLI and pipeline stages (capture, package, jobs, transcribe, classify, recap, review).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "bin": {
    "recap": "./bin/recap.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "recap": "node src/cli/main.ts"
  },
  "dependencies": {
    "@sargas-recap/contracts": "0.0.0",
    "commander": "^15.1.0"
  }
}
