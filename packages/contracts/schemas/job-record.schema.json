{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sargas-recap:schema:job-record:v1",
  "title": "Job record",
  "$comment": "Generated from packages/contracts/src by npm run schemas. Do not edit. Stored as: SQLite jobs row (T07).",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "running",
              "succeeded",
              "failed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "started_at"
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "succeeded",
              "failed",
              "cancelled"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "finished_at"
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "failed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "error"
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "pending",
              "running",
              "succeeded"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "error": false
        }
      }
    }
  ],
  "type": "object",
  "required": [
    "schema_version",
    "job_id",
    "campaign_id",
    "session_id",
    "stage",
    "status",
    "attempt",
    "max_attempts",
    "inputs",
    "outputs",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "description": "Per-record schema version (ADR-002).",
      "const": 1,
      "type": "number"
    },
    "job_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    },
    "campaign_id": {
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
      "description": "Campaign identifier (config, T04).",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
      "description": "Session identifier within a campaign.",
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "import",
        "seal",
        "chunk-plan",
        "transcribe",
        "classify",
        "recap",
        "export"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "attempt": {
      "minimum": 1,
      "maximum": 100,
      "type": "integer"
    },
    "max_attempts": {
      "minimum": 1,
      "maximum": 100,
      "type": "integer"
    },
    "inputs": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "ref",
          "hash"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "artifact",
              "config",
              "glossary",
              "prompt",
              "model",
              "chunk-plan",
              "overrides"
            ]
          },
          "ref": {
            "minLength": 1,
            "maxLength": 240,
            "description": "Path, name or model ID.",
            "type": "string"
          },
          "hash": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        }
      }
    },
    "output_run_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "transcription_run_id or classification_run_id this job produces.",
      "type": "string"
    },
    "output_recap_revision": {
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Monotonic per session (ADR-004).",
      "type": "integer"
    },
    "outputs": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "path",
          "hash"
        ],
        "properties": {
          "path": {
            "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$",
            "maxLength": 240,
            "type": "string"
          },
          "hash": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        }
      }
    },
    "usage": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "properties": {
        "input_tokens": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
        },
        "cost_micro_usd": {
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Integer micro-USD (no floats).",
          "type": "integer"
        }
      }
    },
    "error": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "properties": {
        "code": {
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "maxLength": 500,
          "description": "Actionable; never contains transcript, prompt or secret content.",
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "created_at": {
      "format": "date-time",
      "maxLength": 40,
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "maxLength": 40,
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "maxLength": 40,
      "type": "string"
    }
  }
}
