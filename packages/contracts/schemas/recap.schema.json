{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sargas-recap:schema:recap:v1",
  "title": "Generated recap draft",
  "$comment": "Generated from packages/contracts/src by npm run schemas. Do not edit. Stored as: recap/<revision>/recap.json.",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "campaign_id",
    "session_id",
    "recap_revision",
    "transcription_run_id",
    "classification_run_id",
    "language",
    "generated_at",
    "title",
    "sentences",
    "gm_notes"
  ],
  "properties": {
    "schema_version": {
      "description": "Per-record schema version (ADR-002).",
      "const": 1,
      "type": "number"
    },
    "campaign_id": {
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
      "description": "Campaign identifier (config, T04).",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
      "description": "Session identifier within a campaign.",
      "type": "string"
    },
    "recap_revision": {
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Monotonic per session (ADR-004).",
      "type": "integer"
    },
    "transcription_run_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "Scope that resolves every cited segment_id.",
      "type": "string"
    },
    "classification_run_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    },
    "language": {
      "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "maxLength": 40,
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "maxLength": 200,
      "type": "string"
    },
    "sentences": {
      "minItems": 1,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "sentence_id",
          "text",
          "assertion",
          "citations"
        ],
        "properties": {
          "sentence_id": {
            "pattern": "^r[1-9][0-9]{0,15}:s(?:0|[1-9][0-9]{0,15})$",
            "description": "r<recap_revision>:s<n> (ADR-004).",
            "type": "string"
          },
          "text": {
            "minLength": 1,
            "maxLength": 2000,
            "type": "string"
          },
          "assertion": {
            "description": "background never counts as evidence of what happened this session (T13).",
            "type": "string",
            "enum": [
              "completed",
              "proposed",
              "ongoing",
              "background"
            ]
          },
          "outcome_basis": {
            "type": "string",
            "enum": [
              "roll",
              "narrative"
            ]
          },
          "citations": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "segment_ids",
              "event_ids"
            ],
            "properties": {
              "segment_ids": {
                "uniqueItems": true,
                "type": "array",
                "items": {
                  "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}:(?:0|[1-9][0-9]{0,15}):(?:0|[1-9][0-9]{0,15})$",
                  "description": "<transcription_run_id>:<chunk_index>:<n> (ADR-004).",
                  "type": "string"
                }
              },
              "event_ids": {
                "uniqueItems": true,
                "type": "array",
                "items": {
                  "pattern": "^fvtt:[0-7][0-9A-HJKMNP-TV-Z]{25}:(?:0|[1-9][0-9]{0,15})$",
                  "description": "fvtt:<capture_id>:<seq> (ADR-004).",
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "gm_notes": {
      "description": "GM-only; never exported to players.",
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "note_id",
          "reason",
          "text",
          "citations"
        ],
        "properties": {
          "note_id": {
            "pattern": "^r[1-9][0-9]{0,15}:g(?:0|[1-9][0-9]{0,15})$",
            "description": "r<recap_revision>:g<n> (ADR-004).",
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "unresolved",
              "unsupported",
              "conflict",
              "spoiler"
            ]
          },
          "text": {
            "minLength": 1,
            "maxLength": 2000,
            "type": "string"
          },
          "citations": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "segment_ids",
              "event_ids"
            ],
            "properties": {
              "segment_ids": {
                "uniqueItems": true,
                "type": "array",
                "items": {
                  "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}:(?:0|[1-9][0-9]{0,15}):(?:0|[1-9][0-9]{0,15})$",
                  "description": "<transcription_run_id>:<chunk_index>:<n> (ADR-004).",
                  "type": "string"
                }
              },
              "event_ids": {
                "uniqueItems": true,
                "type": "array",
                "items": {
                  "pattern": "^fvtt:[0-7][0-9A-HJKMNP-TV-Z]{25}:(?:0|[1-9][0-9]{0,15})$",
                  "description": "fvtt:<capture_id>:<seq> (ADR-004).",
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
