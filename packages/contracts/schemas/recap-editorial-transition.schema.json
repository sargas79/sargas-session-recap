    "transition_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    },
    "campaign_id": {
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
      "description": "Campaign identifier (config, T04).",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
      "description": "Session identifier within a campaign.",
      "type": "string"
    },
    "recap_revision": {
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Monotonic per session (ADR-004).",
      "type": "integer"
    },
    "sequence": {
      "minimum": 0,
      "maximum": 9007199254740991,
