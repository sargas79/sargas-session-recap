      "description": "canonicalContentHash of the effective content after the transition (ADR-010).",
      "type": "string"
    },
    "edit_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "The edit that caused a content_edit.",
      "type": "string"
    },
    "approval_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "The approval record an approve created.",
      "type": "string"
    },
    "export_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "The export manifest an export created.",
      "type": "string"
    },
    "reviewer_id": {
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
      "description": "Operator identity slug (ADR-010); not a real name or an email.",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "maxLength": 40,
      "type": "string"
    }
