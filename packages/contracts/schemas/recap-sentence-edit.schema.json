{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sargas-recap:schema:recap-sentence-edit:v1",
  "title": "Recap edit (title, sentence or GM note)",
  "$comment": "Generated from packages/contracts/src by npm run schemas. Do not edit. Stored as: SQLite recap_edits row (T15, ADR-010).",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "target_kind": {
            "enum": [
              "sentence"
            ]
          }
        },
        "required": [
          "target_kind"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "target_id": {
            "type": "string",
            "pattern": "^r[1-9][0-9]{0,15}:s(?:0|[1-9][0-9]{0,15})$"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "target_kind": {
            "enum": [
              "gm_note"
            ]
          }
        },
        "required": [
          "target_kind"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "target_id": {
            "type": "string",
            "pattern": "^r[1-9][0-9]{0,15}:g(?:0|[1-9][0-9]{0,15})$"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "target_kind": {
            "enum": [
              "title"
            ]
          }
        },
        "required": [
          "target_kind"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "target_id": {
            "type": "string",
            "const": "title"
          },
          "action": {
            "type": "string",
            "enum": [
              "replace",
              "revert"
            ]
          },
          "text": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "target_kind": {
            "enum": [
              "title",
              "gm_note"
            ]
          }
        },
        "required": [
          "target_kind"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "citations": false
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "action": {
            "enum": [
              "replace"
            ]
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "text"
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "action": {
            "enum": [
              "remove",
              "revert"
            ]
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "text": false,
          "citations": false
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "target_kind": {
            "type": "string",
            "const": "sentence"
          },
          "action": {
            "type": "string",
            "const": "replace"
          }
        },
        "required": [
          "target_kind",
          "action"
        ]
      },
      "then": {
        "type": "object",
        "required": [
          "citations"
        ]
      }
    }
  ],
  "type": "object",
  "required": [
    "schema_version",
    "edit_id",
    "campaign_id",
    "session_id",
    "recap_revision",
    "sequence",
    "target_kind",
    "target_id",
    "action",
    "reviewer_id",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "description": "Per-record schema version (ADR-002).",
      "const": 1,
      "type": "number"
    },
    "edit_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    },
    "campaign_id": {
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
      "description": "Campaign identifier (config, T04).",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
      "description": "Session identifier within a campaign.",
      "type": "string"
    },
    "recap_revision": {
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Monotonic per session (ADR-004).",
      "type": "integer"
    },
    "sequence": {
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Order of edits within the revision (0, 1, ...).",
      "type": "integer"
    },
    "target_kind": {
      "type": "string",
      "enum": [
        "title",
        "sentence",
        "gm_note"
      ]
    },
    "target_id": {
      "maxLength": 40,
      "description": "sentence_id, note_id, or the literal `title`, per target_kind.",
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "replace",
        "remove",
        "revert"
      ]
    },
    "text": {
      "minLength": 1,
      "maxLength": 2000,
      "description": "New text (replace only).",
      "type": "string"
    },
    "citations": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "segment_ids",
        "event_ids"
      ],
      "properties": {
        "segment_ids": {
          "uniqueItems": true,
          "type": "array",
          "items": {
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}:(?:0|[1-9][0-9]{0,15}):(?:0|[1-9][0-9]{0,15})$",
            "description": "<transcription_run_id>:<chunk_index>:<n> (ADR-004).",
            "type": "string"
          }
        },
        "event_ids": {
          "uniqueItems": true,
          "type": "array",
          "items": {
            "pattern": "^fvtt:[0-7][0-9A-HJKMNP-TV-Z]{25}:(?:0|[1-9][0-9]{0,15})$",
            "description": "fvtt:<capture_id>:<seq> (ADR-004).",
            "type": "string"
          }
        }
      }
    },
    "reviewer_id": {
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
      "description": "Operator identity slug (ADR-010); not a real name or an email.",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "maxLength": 40,
      "type": "string"
    }
  }
}
