{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sargas-recap:schema:effective-transcript-review:v1",
  "title": "Effective transcript with provenance, for GM review (derived)",
  "$comment": "Generated from packages/contracts/src by npm run schemas. Do not edit. Stored as: computed on demand (T12); never authoritative.",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "campaign_id",
    "session_id",
    "transcription_run_id",
    "classification_run_id",
    "generated_at",
    "segments",
    "needs_reconciliation"
  ],
  "properties": {
    "schema_version": {
      "description": "Per-record schema version (ADR-002).",
      "const": 1,
      "type": "number"
    },
    "campaign_id": {
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
      "description": "Campaign identifier (config, T04).",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
      "description": "Session identifier within a campaign.",
      "type": "string"
    },
    "transcription_run_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    },
    "classification_run_id": {
      "anyOf": [
        {
          "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "generated_at": {
      "format": "date-time",
      "maxLength": 40,
      "type": "string"
    },
    "segments": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "segment_id",
          "speaker_id",
          "start_offset_ms",
          "end_offset_ms",
          "timing_uncertainty_ms",
          "text",
          "text_source",
          "label",
          "label_source",
          "recap_inclusion",
          "exclusion_reasons",
          "review_required",
          "review_status",
          "text_original",
          "text_hash",
          "corrections",
          "classification_label",
          "segment_flags",
          "classification_flags"
        ],
        "properties": {
          "segment_id": {
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}:(?:0|[1-9][0-9]{0,15}):(?:0|[1-9][0-9]{0,15})$",
            "description": "<transcription_run_id>:<chunk_index>:<n> (ADR-004).",
            "type": "string"
          },
          "speaker_id": {
            "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
            "description": "Speaker identifier from campaign config.",
            "type": "string"
          },
          "start_offset_ms": {
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "end_offset_ms": {
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "timing_uncertainty_ms": {
            "minimum": 0,
            "maximum": 9007199254740991,
            "type": "integer"
          },
          "text": {
            "minLength": 1,
            "maxLength": 20000,
            "type": "string"
          },
          "text_source": {
            "type": "string",
            "enum": [
              "original",
              "corrected",
              "override"
            ]
          },
          "label": {
            "enum": [
              "ic",
              "narration",
              "rules",
              "ooc",
              "mixed",
              "uncertain",
              null
            ],
            "description": "Effective label; null: not classified yet."
          },
          "label_source": {
            "type": "string",
            "enum": [
              "classification",
              "override",
              "none"
            ]
          },
          "recap_inclusion": {
            "type": "string",
            "enum": [
              "include",
              "exclude",
              "unresolved"
            ]
          },
          "exclusion_reasons": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "spoiler",
                "privacy",
                "off-topic"
              ]
            }
          },
          "review_required": {
            "type": "boolean"
          },
          "review_status": {
            "type": "string",
            "enum": [
              "pending",
              "reviewed"
            ]
          },
          "text_original": {
            "minLength": 1,
            "maxLength": 20000,
            "description": "ASR text, always reachable from the effective view.",
            "type": "string"
          },
          "text_hash": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "text_corrected": {
            "minLength": 1,
            "maxLength": 20000,
            "description": "Classification corrections applied.",
            "type": "string"
          },
          "text_override": {
            "minLength": 1,
            "maxLength": 20000,
            "description": "Cleaned text from the GM.",
            "type": "string"
          },
          "corrections": {
            "description": "What text_corrected changed.",
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "kind",
                "from",
                "to"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "name",
                    "term",
                    "spelling"
                  ]
                },
                "from": {
                  "minLength": 1,
                  "maxLength": 200,
                  "type": "string"
                },
                "to": {
                  "minLength": 1,
                  "maxLength": 200,
                  "type": "string"
                },
                "glossary_id": {
                  "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
                  "description": "Glossary entry that justified it (T04).",
                  "type": "string"
                }
              }
            }
          },
          "classification_label": {
            "enum": [
              "ic",
              "narration",
              "rules",
              "ooc",
              "mixed",
              "uncertain",
              null
            ],
            "description": "Label before any override; null: not classified yet."
          },
          "segment_flags": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "short",
                "low_confidence",
                "overlap",
                "timestamp_clamped",
                "repetition_loop"
              ]
            }
          },
          "classification_flags": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "names_unmatched",
                "event_context_used",
                "low_asr_confidence",
                "possible_spoiler"
              ]
            }
          },
          "confidence_permille": {
            "minimum": 0,
            "maximum": 1000,
            "type": "integer"
          },
          "override_id": {
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "description": "The override attached to this segment.",
            "type": "string"
          }
        }
      }
    },
    "needs_reconciliation": {
      "description": "Overrides not applied because their identity did not match (ADR-005).",
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "override_id",
          "transcription_run_id",
          "segment_id",
          "reason",
          "exclusion_reasons"
        ],
        "properties": {
          "override_id": {
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "type": "string"
          },
          "transcription_run_id": {
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
            "description": "The run the override was made on.",
            "type": "string"
          },
          "segment_id": {
            "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}:(?:0|[1-9][0-9]{0,15}):(?:0|[1-9][0-9]{0,15})$",
            "description": "<transcription_run_id>:<chunk_index>:<n> (ADR-004).",
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "run_changed",
              "segment_missing",
              "text_changed"
            ]
          },
          "exclusion_reasons": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "spoiler",
                "privacy",
                "off-topic"
              ]
            }
          }
        }
      }
    }
  }
}
