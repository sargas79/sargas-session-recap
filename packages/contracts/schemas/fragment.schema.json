{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sargas-recap:schema:fragment:v1",
  "title": "Audio fragment record",
  "$comment": "Generated from packages/contracts/src by npm run schemas. Do not edit. Stored as: fragments.jsonl (one record per line).",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "fragment_id",
    "speaker_id",
    "track_label",
    "path",
    "codec",
    "sample_rate_hz",
    "channels",
    "sample_count",
    "duration_ms",
    "fragment_start_offset_ms",
    "timing_uncertainty_ms",
    "status"
  ],
  "properties": {
    "schema_version": {
      "description": "Per-record schema version (ADR-002).",
      "const": 1,
      "type": "number"
    },
    "fragment_id": {
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?:(?:0|[1-9][0-9]{0,15})$",
      "description": "<speaker_id>:<n> (ADR-004).",
      "type": "string"
    },
    "speaker_id": {
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
      "description": "Speaker identifier from campaign config.",
      "type": "string"
    },
    "track_label": {
      "minLength": 1,
      "maxLength": 128,
      "description": "Source track name as imported or recorded (operator-visible, not content).",
      "type": "string"
    },
    "path": {
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$",
      "maxLength": 240,
      "description": "Package-relative audio path, e.g. audio/<speaker_id>/<n>.flac.",
      "type": "string"
    },
    "codec": {
      "type": "string",
      "enum": [
        "pcm_s16le",
        "flac",
        "opus"
      ]
    },
    "sample_rate_hz": {
      "minimum": 8000,
      "maximum": 192000,
      "type": "integer"
    },
    "channels": {
      "minimum": 1,
      "maximum": 8,
      "type": "integer"
    },
    "sample_count": {
      "minimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "duration_ms": {
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "floor(sample_count * 1000 / sample_rate_hz).",
      "type": "integer"
    },
    "fragment_start_offset_ms": {
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "description": "Session offset of sample 0. Zero is the sync marker (ADR-003).",
      "type": "integer"
    },
    "timing_uncertainty_ms": {
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Bound on the error of fragment_start_offset_ms.",
      "type": "integer"
    },
    "status": {
      "description": "`incomplete`/`recovered`: capture was interrupted (T06 startup recovery).",
      "type": "string",
      "enum": [
        "complete",
        "incomplete",
        "recovered"
      ]
    }
  }
}
