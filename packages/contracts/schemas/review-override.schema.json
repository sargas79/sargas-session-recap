{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sargas-recap:schema:review-override:v1",
  "title": "GM review override",
  "$comment": "Generated from packages/contracts/src by npm run schemas. Do not edit. Stored as: SQLite review_overrides row (T12).",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "override_id",
    "campaign_id",
    "session_id",
    "transcription_run_id",
    "segment_id",
    "base_text_hash",
    "recap_inclusion",
    "exclusion_reasons",
    "review_status",
    "reconciliation",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "description": "Per-record schema version (ADR-002).",
      "const": 1,
      "type": "number"
    },
    "override_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    },
    "campaign_id": {
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
      "description": "Campaign identifier (config, T04).",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
      "description": "Session identifier within a campaign.",
      "type": "string"
    },
    "transcription_run_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "type": "string"
    },
    "segment_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}:(?:0|[1-9][0-9]{0,15}):(?:0|[1-9][0-9]{0,15})$",
      "description": "<transcription_run_id>:<chunk_index>:<n> (ADR-004).",
      "type": "string"
    },
    "base_text_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "text_hash of the segment when the override was made.",
      "type": "string"
    },
    "label_override": {
      "description": "Classification label (T11).",
      "type": "string",
      "enum": [
        "ic",
        "narration",
        "rules",
        "ooc",
        "mixed",
        "uncertain"
      ]
    },
    "recap_inclusion": {
      "type": "string",
      "enum": [
        "include",
        "exclude",
        "unresolved"
      ]
    },
    "text_override": {
      "minLength": 1,
      "maxLength": 20000,
      "description": "Cleaned text, e.g. IC part of mixed.",
      "type": "string"
    },
    "exclusion_reasons": {
      "uniqueItems": true,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "spoiler",
          "privacy",
          "off-topic"
        ]
      }
    },
    "review_status": {
      "type": "string",
      "enum": [
        "pending",
        "reviewed"
      ]
    },
    "reconciliation": {
      "description": "needs_reconciliation: identity no longer matches; never auto-applied (ADR-005).",
      "type": "string",
      "enum": [
        "attached",
        "needs_reconciliation"
      ]
    },
    "supersedes_override_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "Override this one replaces after an explicit reconciliation.",
      "type": "string"
    },
    "revision": {
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Row history counter; each change appends history (T12).",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "maxLength": 40,
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "maxLength": 40,
      "type": "string"
    }
  }
}
