{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sargas-recap:schema:foundry-event:v1",
  "title": "Foundry event envelope",
  "$comment": "Generated from packages/contracts/src by npm run schemas. Do not edit. Stored as: foundry.jsonl (one record per line).",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "capture_id",
    "seq",
    "campaign_id",
    "session_id",
    "world_id",
    "writer_user_id",
    "foundry_version",
    "system_id",
    "system_version",
    "type",
    "observed_at_unix_ms",
    "clock_uncertainty_ms",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "description": "Per-record schema version (ADR-002).",
      "const": 1,
      "type": "number"
    },
    "event_id": {
      "pattern": "^fvtt:[0-7][0-9A-HJKMNP-TV-Z]{25}:(?:0|[1-9][0-9]{0,15})$",
      "description": "fvtt:<capture_id>:<seq> (ADR-004).",
      "type": "string"
    },
    "capture_id": {
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
      "description": "One designated-writer capture session (T16).",
      "type": "string"
    },
    "seq": {
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Monotonic per capture_id; event_id = fvtt:<capture_id>:<seq>.",
      "type": "integer"
    },
    "campaign_id": {
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
      "description": "Campaign identifier (config, T04).",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$",
      "description": "Session identifier within a campaign.",
      "type": "string"
    },
    "world_id": {
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
    },
    "writer_user_id": {
      "pattern": "^[A-Za-z0-9]{16}$",
      "description": "Foundry user document ID of the designated writer.",
      "type": "string"
    },
    "foundry_version": {
      "pattern": "^[0-9]+(?:\\.[0-9]+){0,2}$",
      "type": "string"
    },
    "system_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$",
      "type": "string"
    },
    "system_version": {
      "minLength": 1,
      "maxLength": 32,
      "type": "string"
    },
    "type": {
      "pattern": "^[a-z0-9-]+(?:\\.[a-z0-9-]+)+$",
      "maxLength": 64,
      "description": "Namespaced event type, e.g. core.roll, core.scene, pf2e.condition.",
      "type": "string"
    },
    "observed_at_unix_ms": {
      "minimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "clock_uncertainty_ms": {
      "minimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "payload": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {}
      }
    }
  }
}
